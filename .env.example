APP_MODE=observe

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-2024-08-06

X_BEARER_TOKEN=
X_API_BASE_URL=https://api.x.com

OANDA_ENVIRONMENT=practice
OANDA_API_TOKEN=
OANDA_ACCOUNT_ID=

DATABASE_URL=sqlite:///data/copy_trader.db

REQUIRE_HUMAN_APPROVAL=true
# Starting value only -- live-toggleable from the dashboard without a
# restart. When true, any signal that already passed every validation/risk
# check executes immediately with no human click, regardless of
# requires_human_review. observe mode is never affected (it never submits
# orders regardless of this setting).
AUTO_APPROVE_PROPOSALS=false
MIN_SIGNAL_CONFIDENCE=0.90
MAX_SIGNAL_AGE_MINUTES=10
PROPOSAL_EXPIRY_MINUTES=5

# Optional: webhook shared secret for the webhook input adapter (Section 2 /
# Phase 2 of DESIGN.md). Leave blank to disable the webhook route entirely.
WEBHOOK_SHARED_SECRET=

# Optional: gates every write route (approve/reject, add/remove accounts,
# kill switch, manual post submit, auto-approve toggle) behind a login --
# see app/auth.py. Leave blank for local use (no login required, same as
# before). Set this for any public deployment.
OPERATOR_PASSWORD=
# Set true only behind real HTTPS -- a Secure cookie is silently dropped by
# browsers over plain http, which would break local login testing.
SECURE_COOKIES=false
# This service's own public URL, e.g. https://x-copy-trade-tool.onrender.com.
# When set, a keep-alive thread pings it periodically to avoid free-tier
# host spin-down. Leave blank locally.
PUBLIC_URL=
